{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sayed-reda",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "assets": {
    "directory": "."
  }
}
